# Copy to deploy/.env and adjust.
# Host directories (must exist, writable by PUID:PGID below; so must ./data)
DOWNLOADS_DIR=/srv/downloads
MEDIA_DIR=/srv/media
# The container runs as this uid/gid — the owner of those directories: `id -u` / `id -g`
PUID=1000
PGID=1000
TZ=UTC
# 127.0.0.1 = only reachable via a reverse proxy on this host; 0.0.0.0 = LAN
BIND=127.0.0.1
# Optional: LAN ranges that skip login, e.g. 192.168.0.0/16,10.0.0.0/8
TRUSTED_NETWORKS=
TRUSTED_ROLE=admin
# sqlite (default) or mysql
DB_DRIVER=sqlite
# mysql only, e.g. xirc:pw@tcp(db:3306)/xirc (bundled), or
# xirc:pw@tcp(host.docker.internal:3306)/xirc (MariaDB on the Docker host)
DB_DSN=
# "mariadb" starts the bundled MariaDB container (then also set the two passwords)
COMPOSE_PROFILES=
# Only used with COMPOSE_PROFILES=mariadb
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
# Only with a subpath reverse proxy, e.g. /xirc
XIRC_SERVER_PREFIX=
